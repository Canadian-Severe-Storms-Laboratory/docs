---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import type { NavGroup } from '@/components/Sidebar.astro';
import { docUrl, editUrl, sortDocs, type Doc } from '@/lib/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id === 'index' ? undefined : doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props as { doc: Doc };
const { Content, headings } = await render(doc);

const sortedDocs = sortDocs(await getCollection('docs'));

const groupsMap = new Map<string, NavGroup>();
for (const item of sortedDocs) {
  const name = item.data.group;
  if (!groupsMap.has(name)) groupsMap.set(name, { name, items: [] });
  groupsMap.get(name)!.items.push({
    title: item.data.sidebarTitle ?? item.data.title,
    url: docUrl(item),
    icon: item.data.icon,
    badge: item.data.badge,
  });
}

const index = sortedDocs.findIndex((d) => d.id === doc.id);
const toLink = (d?: Doc) => (d ? { title: d.data.sidebarTitle ?? d.data.title, url: docUrl(d) } : null);
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  group={doc.data.group}
  headings={headings}
  prev={toLink(sortedDocs[index - 1])}
  next={toLink(sortedDocs[index + 1])}
  currentPath={docUrl(doc)}
  groups={[...groupsMap.values()]}
  editUrl={editUrl(doc)}
>
  <Content />
</DocsLayout>

---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar, { type NavGroup } from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageNavigation, { type PageLink } from '../components/PageNavigation.astro';

interface Props {
  title: string;
  description?: string;
  group?: string;
  headings?: MarkdownHeading[];
  prev?: PageLink | null;
  next?: PageLink | null;
  currentPath: string;
  groups: NavGroup[];
  editUrl?: string;
}

const { title, description, group, headings = [], prev, next, currentPath, groups, editUrl } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header currentPath={currentPath} />

  <div class="mx-auto flex w-full max-w-[90rem] flex-1 px-4 sm:px-6 lg:px-8">
    <Sidebar currentPath={currentPath} groups={groups} />

    <main class="min-w-0 flex-1 pt-8 pb-16 md:pl-8 lg:pl-12 xl:pr-12">
      <div class="mx-auto max-w-3xl">
        <Breadcrumbs group={group} />

        <header class="mb-8">
          <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-[2rem]">{title}</h1>
          {description && <p class="mt-2 text-lg leading-relaxed text-muted-foreground">{description}</p>}
        </header>

        <article class="docs-prose">
          <slot />
        </article>

        <PageNavigation prev={prev} next={next} />

        <footer class="mt-12 flex flex-col gap-3 border-t border-border/60 pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
          <span>Canadian Severe Storms Laboratory · Western University</span>
          <div class="flex items-center gap-4">
            <a href="https://weather.cssl.ca" target="_blank" rel="noopener noreferrer" class="hover:text-foreground">
              Weather Intelligence
            </a>
            <a href="https://cssl.ca" target="_blank" rel="noopener noreferrer" class="hover:text-foreground">
              cssl.ca
            </a>
            <a
              href="https://github.com/Canadian-Severe-Storms-Laboratory"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground"
            >
              GitHub
            </a>
          </div>
        </footer>
      </div>
    </main>

    <TableOfContents headings={headings} editUrl={editUrl} />
  </div>
</BaseLayout>

<script>
  function setupDocs() {
    // Anchor links on section headings.
    document.querySelectorAll<HTMLHeadingElement>('.docs-prose h2[id], .docs-prose h3[id]').forEach((heading) => {
      if (heading.querySelector('.heading-anchor')) return;
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.setAttribute('aria-label', 'Link to this section');
      heading.appendChild(anchor);
    });

    // Copy buttons on standalone code blocks (<CodeGroup> has its own).
    document.querySelectorAll<HTMLPreElement>('.docs-prose pre').forEach((pre) => {
      if (pre.closest('.code-group')) return;
      if (pre.parentElement?.classList.contains('code-block')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.replaceWith(wrapper);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
          button.textContent = 'Copied';
          setTimeout(() => (button.textContent = 'Copy'), 1500);
        } catch {
          button.textContent = 'Failed';
        }
      });
      wrapper.appendChild(button);
    });
  }

  setupDocs();
  document.addEventListener('astro:page-load', setupDocs);
</script>

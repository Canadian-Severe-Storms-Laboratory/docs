---
import { ArrowLeft, ArrowRight } from 'lucide-astro';

export interface PageLink {
  title: string;
  url: string;
}

interface Props {
  prev?: PageLink | null;
  next?: PageLink | null;
}

const { prev, next } = Astro.props;

const linkClass =
  'group flex flex-col gap-1 rounded-xl border border-border/80 px-4 py-3 transition-colors hover:border-tempest/50';
---

{(prev || next) && (
  <nav class="mt-14 grid grid-cols-1 gap-3 sm:grid-cols-2" aria-label="Pagination">
    {prev ? (
      <a href={prev.url} class={linkClass}>
        <span class="flex items-center gap-1 text-xs text-muted-foreground">
          <ArrowLeft class="h-3.5 w-3.5" /> Previous
        </span>
        <span class="text-sm font-medium text-foreground group-hover:text-tempest">{prev.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )}
    {next && (
      <a href={next.url} class={`${linkClass} items-end text-right`}>
        <span class="flex items-center gap-1 text-xs text-muted-foreground">
          Next <ArrowRight class="h-3.5 w-3.5" />
        </span>
        <span class="text-sm font-medium text-foreground group-hover:text-tempest">{next.title}</span>
      </a>
    )}
  </nav>
)}

---
import { Moon, Sun } from 'lucide-astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Toggle dark mode"
  class={`inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground cursor-pointer ${className}`}
>
  <Sun class="h-4 w-4 dark:hidden" />
  <Moon class="hidden h-4 w-4 dark:block" />
</button>

<script>
  const toggle = document.getElementById('theme-toggle');

  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const theme = root.classList.contains('dark') ? 'light' : 'dark';

    root.classList.remove('dark', 'light');
    root.classList.add(theme);
    root.style.colorScheme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#101013' : '#ffffff');

    try {
      localStorage.setItem('vite-ui-theme', theme);
    } catch {}
  });
</script>

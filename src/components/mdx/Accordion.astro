---
import { ChevronRight } from 'lucide-astro';

interface Props {
  title: string;
  defaultOpen?: boolean;
}

const { title, defaultOpen = false } = Astro.props;
---

<details open={defaultOpen || undefined} class="group not-prose rounded-xl border border-border/80">
  <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm font-medium text-foreground select-none [&::-webkit-details-marker]:hidden">
    <ChevronRight class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-150 group-open:rotate-90" />
    <span>{title}</span>
  </summary>
  <div class="docs-prose border-t border-border/70 px-4 py-3 text-sm">
    <slot />
  </div>
</details>

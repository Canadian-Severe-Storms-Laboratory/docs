---
// Tabbed content. Pass `labels` and one <TabItem> per label, in order.
interface Props {
  labels: string[];
  class?: string;
}

const { labels, class: className = '' } = Astro.props;
---

<div class={`mint-tabs not-prose my-6 ${className}`}>
  <div class="flex items-center gap-1 overflow-x-auto overflow-y-hidden border-b border-border/80 [scrollbar-width:none]" role="tablist">
    {labels.map((label, index) => (
      <button
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        data-tab-index={index}
        class={`tab-trigger -mb-px cursor-pointer border-b-2 px-3 py-2 text-sm whitespace-nowrap transition-colors ${
          index === 0
            ? 'border-tempest font-medium text-foreground'
            : 'border-transparent text-muted-foreground hover:text-foreground'
        }`}
      >
        {label}
      </button>
    ))}
  </div>
  <div class="tabs-content pt-4">
    <slot />
  </div>
</div>

<script>
  function setupTabs() {
    document.querySelectorAll<HTMLElement>('.mint-tabs').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const triggers = [...container.querySelectorAll<HTMLButtonElement>(':scope > [role="tablist"] > .tab-trigger')];
      const panels = [...container.querySelectorAll<HTMLElement>(':scope > .tabs-content > .tab-panel')];

      triggers.forEach((trigger, i) => {
        trigger.addEventListener('click', () => {
          triggers.forEach((t, idx) => {
            const selected = idx === i;
            t.setAttribute('aria-selected', String(selected));
            t.classList.toggle('border-tempest', selected);
            t.classList.toggle('font-medium', selected);
            t.classList.toggle('text-foreground', selected);
            t.classList.toggle('border-transparent', !selected);
            t.classList.toggle('text-muted-foreground', !selected);
          });
          panels.forEach((p, idx) => p.classList.toggle('hidden', idx !== i));
        });
      });
    });
  }

  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>

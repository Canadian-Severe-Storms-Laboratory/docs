---
interface Props {
  labels?: string[];
  class?: string;
}

const { labels = [], class: className = '' } = Astro.props;
const tabsId = `tabs-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`mint-tabs my-6 rounded-xl border border-border/80 bg-card overflow-hidden not-prose ${className}`} id={tabsId}>
  {labels.length > 0 && (
    <div class="flex items-center gap-1 border-b border-border/80 bg-muted/30 px-3 pt-2">
      {labels.map((label, index) => (
        <button
          type="button"
          class={`tab-trigger px-3.5 py-1.5 text-xs font-medium rounded-t-md transition-colors cursor-pointer border-b-2 -mb-[1px] ${
            index === 0
              ? 'border-tempest text-tempest font-semibold bg-background/50'
              : 'border-transparent text-muted-foreground hover:text-foreground'
          }`}
          data-tab-index={index}
        >
          {label}
        </button>
      ))}
    </div>
  )}

  <div class="tabs-content p-4">
    <slot />
  </div>
</div>

<script>
  function setupTabs() {
    document.querySelectorAll('.mint-tabs').forEach((container) => {
      const triggers = container.querySelectorAll<HTMLButtonElement>('.tab-trigger');
      const panels = container.querySelectorAll<HTMLElement>('.tab-panel');

      // If triggers exist in header
      if (triggers.length > 0) {
        triggers.forEach((trigger, idx) => {
          trigger.addEventListener('click', () => {
            triggers.forEach((t) => {
              t.classList.remove('border-tempest', 'text-tempest', 'font-semibold', 'bg-background/50');
              t.classList.add('border-transparent', 'text-muted-foreground');
            });
            trigger.classList.add('border-tempest', 'text-tempest', 'font-semibold', 'bg-background/50');
            trigger.classList.remove('border-transparent', 'text-muted-foreground');

            panels.forEach((p, pIdx) => {
              if (pIdx === idx) {
                p.classList.remove('hidden');
              } else {
                p.classList.add('hidden');
              }
            });
          });
        });
      }
    });
  }

  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>

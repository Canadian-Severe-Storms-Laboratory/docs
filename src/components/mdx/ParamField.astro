---
// A request parameter. Set exactly one of query / path / body / header to its name.
interface Props {
  query?: string;
  path?: string;
  body?: string;
  header?: string;
  type: string;
  required?: boolean;
  default?: string;
}

const { query, path, body, header, type, required = false, default: defaultValue } = Astro.props;

const name = query ?? path ?? body ?? header;
const location = query ? 'query' : path ? 'path' : body ? 'body' : header ? 'header' : undefined;
---

<div class="not-prose border-b border-border/70 py-4 first:pt-2 last:border-b-0">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
    <code class="font-mono font-semibold text-tempest">{name}</code>
    <span class="font-mono text-xs text-muted-foreground">{type}</span>
    {location && <span class="rounded bg-muted px-1.5 py-px text-[11px] text-muted-foreground">{location}</span>}
    {required && <span class="rounded bg-tempest/10 px-1.5 py-px text-[11px] font-medium text-tempest">required</span>}
    {defaultValue && (
      <span class="text-xs text-muted-foreground">
        default <code class="font-mono text-foreground/80">{defaultValue}</code>
      </span>
    )}
  </div>
  <div class="field-body mt-1.5 text-sm leading-relaxed text-foreground/80">
    <slot />
  </div>
</div>

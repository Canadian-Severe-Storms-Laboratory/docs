---
// Tabbed code blocks. Each child fence becomes a tab, labelled by its
// `title="…"` meta or, failing that, its language.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`code-group not-prose my-6 overflow-hidden rounded-xl border border-border/80 bg-[var(--code-bg)] ${className}`}>
  <div class="flex items-center justify-between gap-2 border-b border-white/10 pr-2">
    <div class="code-group-tabs flex min-w-0 items-center overflow-x-auto overflow-y-hidden px-2 text-xs [scrollbar-width:none]" role="tablist"></div>
    <button type="button" class="code-copy-inline shrink-0 cursor-pointer rounded-md px-2 py-1 text-xs text-white/60 transition-colors hover:bg-white/10 hover:text-white">
      Copy
    </button>
  </div>
  <div class="code-group-content [&>pre]:!m-0 [&>pre]:!rounded-none [&>pre]:!border-0">
    <slot />
  </div>
</div>

<script>
  const LANGUAGE_LABELS: Record<string, string> = {
    bash: 'Shell',
    sh: 'Shell',
    shell: 'Shell',
    js: 'JavaScript',
    javascript: 'JavaScript',
    ts: 'TypeScript',
    typescript: 'TypeScript',
    py: 'Python',
    python: 'Python',
    json: 'JSON',
    http: 'HTTP',
    csv: 'CSV',
  };

  function setupCodeGroups() {
    document.querySelectorAll<HTMLElement>('.code-group').forEach((group) => {
      if (group.dataset.initialized) return;
      group.dataset.initialized = 'true';

      const tabs = group.querySelector('.code-group-tabs')!;
      const pres = [...group.querySelectorAll<HTMLPreElement>('.code-group-content > pre')];
      const copy = group.querySelector<HTMLButtonElement>('.code-copy-inline')!;
      let active = 0;

      const buttons = pres.map((pre, i) => {
        const lang = pre.dataset.language ?? '';
        const button = document.createElement('button');
        button.type = 'button';
        button.setAttribute('role', 'tab');
        button.textContent = pre.dataset.title ?? LANGUAGE_LABELS[lang] ?? lang.toUpperCase();
        button.className =
          'code-tab -mb-px cursor-pointer border-b-2 px-2.5 py-2.5 whitespace-nowrap transition-colors';
        button.addEventListener('click', () => show(i));
        tabs.appendChild(button);
        return button;
      });

      function show(i: number) {
        active = i;
        pres.forEach((pre, idx) => (pre.hidden = idx !== i));
        buttons.forEach((b, idx) => {
          const selected = idx === i;
          b.setAttribute('aria-selected', String(selected));
          b.classList.toggle('border-tempest', selected);
          b.classList.toggle('text-white', selected);
          b.classList.toggle('border-transparent', !selected);
          b.classList.toggle('text-white/55', !selected);
        });
      }

      copy.addEventListener('click', async () => {
        const pre = pres[active];
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
          copy.textContent = 'Copied';
          setTimeout(() => (copy.textContent = 'Copy'), 1500);
        } catch {
          copy.textContent = 'Failed';
        }
      });

      show(0);
    });
  }

  setupCodeGroups();
  document.addEventListener('astro:page-load', setupCodeGroups);
</script>

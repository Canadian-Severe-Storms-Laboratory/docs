---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`relative [counter-increment:step] pb-2 ${className}`}>
  <!-- Number indicator pill positioned on left border line -->
  <span
    class="absolute -left-[42px] top-0 flex h-7 w-7 items-center justify-center rounded-full border border-border bg-card text-xs font-semibold text-foreground shadow-xs ring-4 ring-background"
    aria-hidden="true"
  >
    <span class="text-tempest font-bold text-[11px] [content:counter(step)] before:[content:counter(step)]"></span>
  </span>

  <h3 class="mb-2 text-base font-semibold tracking-tight text-foreground">
    {title}
  </h3>

  <div class="space-y-3 text-sm leading-relaxed text-foreground/80 docs-prose">
    <slot />
  </div>
</div>

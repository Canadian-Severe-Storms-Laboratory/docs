---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="step relative pb-8 pl-10 last:pb-0">
  <span
    class="step-number absolute top-0 left-0 flex h-7 w-7 items-center justify-center rounded-full border border-border bg-background text-xs font-semibold text-foreground"
    aria-hidden="true"
  ></span>
  <span class="step-line absolute top-8 bottom-1 left-[13.5px] w-px bg-border" aria-hidden="true"></span>
  <h3 class="mb-2 pt-0.5 text-base font-semibold tracking-tight text-foreground">{title}</h3>
  <div class="docs-prose text-[15px]">
    <slot />
  </div>
</div>

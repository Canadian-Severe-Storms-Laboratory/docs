---
// One panel of <Tabs>. The first panel should set `default`.
interface Props {
  default?: boolean;
  class?: string;
}

const { default: isDefault = false, class: className = '' } = Astro.props;
---

<div role="tabpanel" class={`tab-panel docs-prose ${isDefault ? '' : 'hidden'} ${className}`}>
  <slot />
</div>

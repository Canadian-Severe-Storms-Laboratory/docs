---
import { AlertCircle, AlertTriangle, CheckCircle2, Info, Lightbulb } from 'lucide-astro';

type CalloutType = 'note' | 'tip' | 'info' | 'warning' | 'danger';

interface Props {
  type?: CalloutType;
  title?: string;
  class?: string;
}

const { type = 'note', title, class: className = '' } = Astro.props;

const styles: Record<
  CalloutType,
  {
    border: string;
    bg: string;
    iconColor: string;
    titleColor: string;
    defaultTitle: string;
  }
> = {
  note: {
    border: 'border-blue-500/30 dark:border-blue-500/20',
    bg: 'bg-blue-500/[0.04] dark:bg-blue-500/[0.08]',
    iconColor: 'text-blue-600 dark:text-blue-400',
    titleColor: 'text-blue-900 dark:text-blue-200',
    defaultTitle: 'Note',
  },
  tip: {
    border: 'border-emerald-500/30 dark:border-emerald-500/20',
    bg: 'bg-emerald-500/[0.04] dark:bg-emerald-500/[0.08]',
    iconColor: 'text-emerald-600 dark:text-emerald-400',
    titleColor: 'text-emerald-900 dark:text-emerald-200',
    defaultTitle: 'Tip',
  },
  info: {
    border: 'border-cyan-500/30 dark:border-cyan-500/20',
    bg: 'bg-cyan-500/[0.04] dark:bg-cyan-500/[0.08]',
    iconColor: 'text-cyan-600 dark:text-cyan-400',
    titleColor: 'text-cyan-900 dark:text-cyan-200',
    defaultTitle: 'Info',
  },
  warning: {
    border: 'border-amber-500/35 dark:border-amber-500/25',
    bg: 'bg-amber-500/[0.05] dark:bg-amber-500/[0.09]',
    iconColor: 'text-amber-600 dark:text-amber-400',
    titleColor: 'text-amber-900 dark:text-amber-200',
    defaultTitle: 'Warning',
  },
  danger: {
    border: 'border-tempest/40 dark:border-tempest/30',
    bg: 'bg-tempest/[0.05] dark:bg-tempest/[0.1]',
    iconColor: 'text-tempest',
    titleColor: 'text-red-900 dark:text-red-200',
    defaultTitle: 'Caution',
  },
};

const current = styles[type] || styles.note;
const displayTitle = title || current.defaultTitle;
---

<div
  class={`my-6 flex gap-3.5 rounded-xl border p-4.5 text-sm leading-relaxed ${current.border} ${current.bg} not-prose ${className}`}
>
  <div class={`mt-0.5 shrink-0 ${current.iconColor}`}>
    {type === 'note' && <Info class="h-5 w-5" />}
    {type === 'tip' && <Lightbulb class="h-5 w-5" />}
    {type === 'info' && <CheckCircle2 class="h-5 w-5" />}
    {type === 'warning' && <AlertTriangle class="h-5 w-5" />}
    {type === 'danger' && <AlertCircle class="h-5 w-5" />}
  </div>

  <div class="flex-1 min-w-0">
    {displayTitle && (
      <div class={`mb-1 font-semibold tracking-tight ${current.titleColor}`}>
        {displayTitle}
      </div>
    )}
    <div class="text-foreground/85 dark:text-foreground/90 [&>p]:my-1 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
      <slot />
    </div>
  </div>
</div>

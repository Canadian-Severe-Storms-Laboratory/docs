---
import { CircleAlert, Info, Lightbulb, TriangleAlert } from 'lucide-astro';

type CalloutType = 'note' | 'info' | 'tip' | 'warning' | 'danger';

interface Props {
  type?: CalloutType;
  title?: string;
  class?: string;
}

const { type = 'note', title, class: className = '' } = Astro.props;

const styles = {
  note: { icon: Info, box: 'border-sky-500/25 bg-sky-500/[0.06]', accent: 'text-sky-600 dark:text-sky-400' },
  tip: { icon: Lightbulb, box: 'border-emerald-500/25 bg-emerald-500/[0.06]', accent: 'text-emerald-600 dark:text-emerald-400' },
  warning: { icon: TriangleAlert, box: 'border-amber-500/30 bg-amber-500/[0.07]', accent: 'text-amber-600 dark:text-amber-400' },
  danger: { icon: CircleAlert, box: 'border-tempest/30 bg-tempest/[0.06]', accent: 'text-tempest' },
};

const style = styles[type === 'info' ? 'note' : type] ?? styles.note;
const Icon = style.icon;
---

<div class={`not-prose my-6 flex gap-3 rounded-xl border px-4 py-3.5 text-sm leading-relaxed ${style.box} ${className}`}>
  <Icon class={`mt-0.5 h-4 w-4 shrink-0 ${style.accent}`} />
  <div class="callout-body min-w-0 flex-1 text-foreground/85">
    {title && <p class="mb-1 font-semibold text-foreground">{title}</p>}
    <slot />
  </div>
</div>

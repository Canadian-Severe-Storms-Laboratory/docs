---
interface Props {
  name: string;
  type: string;
  required?: boolean;
}

const { name, type, required = false } = Astro.props;
---

<div class="not-prose border-b border-border/70 py-4 first:pt-2 last:border-b-0">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
    <code class="font-mono font-semibold text-foreground">{name}</code>
    <span class="font-mono text-xs text-muted-foreground">{type}</span>
    {required && <span class="rounded bg-muted px-1.5 py-px text-[11px] text-muted-foreground">always present</span>}
  </div>
  <div class="field-body mt-1.5 text-sm leading-relaxed text-foreground/80">
    <slot />
  </div>
</div>

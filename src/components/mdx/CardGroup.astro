---
interface Props {
  cols?: 1 | 2 | 3 | 4;
  class?: string;
}

const { cols = 2, class: className = '' } = Astro.props;

const gridColsClass = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
}[cols];
---

<div class={`grid ${gridColsClass} gap-4 my-6 not-prose no-underline ${className}`} style="text-decoration: none;">
  <slot />
</div>

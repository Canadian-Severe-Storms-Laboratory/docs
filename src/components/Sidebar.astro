---
import {
  Activity,
  BookOpen,
  Code,
  Cpu,
  Database,
  FileText,
  Layers,
  Rocket,
  Shield,
  Sparkles,
  Terminal,
  Zap,
} from 'lucide-astro';

export interface NavItem {
  title: string;
  url: string;
  icon?: string;
  badge?: string;
}

export interface NavGroup {
  name: string;
  items: NavItem[];
}

interface Props {
  currentPath: string;
  groups: NavGroup[];
  class?: string;
}

const { currentPath, groups, class: className = '' } = Astro.props;

// Normalize path for comparison
const cleanCurrent = currentPath.replace(/\/$/, '') || '/docs';
---

<aside
  id="sidebar"
  class={`fixed inset-y-0 left-0 z-50 w-72 -translate-x-full border-r border-border/80 bg-background/95 backdrop-blur-md pt-16 transition-transform duration-200 md:sticky md:top-16 md:z-0 md:h-[calc(100vh-4rem)] md:w-64 md:translate-x-0 md:bg-transparent md:pt-6 md:backdrop-blur-none ${className}`}
>
  <div class="h-full overflow-y-auto px-4 pb-12">
    <nav class="space-y-6">
      {groups.map((group) => (
        <div>
          <h4 class="mb-2 px-3 text-[11px] font-bold tracking-[0.14em] text-muted-foreground/80 uppercase">
            {group.name}
          </h4>
          <ul class="space-y-1">
            {group.items.map((item) => {
              const cleanItemUrl = item.url.replace(/\/$/, '');
              const isActive = cleanCurrent === cleanItemUrl;

              return (
                <li>
                  <a
                    href={item.url}
                    class={`group relative flex items-center justify-between rounded-lg px-3 py-2 text-sm transition-all duration-150 ${
                      isActive
                        ? 'bg-tempest/[0.08] font-medium text-tempest dark:bg-tempest/[0.14] dark:text-tempest'
                        : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground'
                    }`}
                  >
                    <!-- Active indicator pill on left edge -->
                    {isActive && (
                      <span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-r-md bg-tempest" />
                    )}

                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class={`shrink-0 transition-colors ${isActive ? 'text-tempest' : 'text-muted-foreground/70 group-hover:text-foreground'}`}>
                        {item.icon === 'rocket' && <Rocket class="h-4 w-4" />}
                        {item.icon === 'zap' && <Zap class="h-4 w-4" />}
                        {item.icon === 'book-open' && <BookOpen class="h-4 w-4" />}
                        {item.icon === 'layers' && <Layers class="h-4 w-4" />}
                        {item.icon === 'database' && <Database class="h-4 w-4" />}
                        {item.icon === 'cpu' && <Cpu class="h-4 w-4" />}
                        {item.icon === 'activity' && <Activity class="h-4 w-4" />}
                        {item.icon === 'terminal' && <Terminal class="h-4 w-4" />}
                        {item.icon === 'code' && <Code class="h-4 w-4" />}
                        {item.icon === 'sparkles' && <Sparkles class="h-4 w-4" />}
                        {item.icon === 'shield' && <Shield class="h-4 w-4" />}
                        {!item.icon && <FileText class="h-4 w-4" />}
                      </span>
                      <span class="truncate">{item.title}</span>
                    </div>

                    {item.badge && (
                      <span
                        class={`ml-2 shrink-0 rounded px-1.5 py-0.2 text-[9.5px] font-semibold tracking-wider uppercase ${
                          item.badge === 'New'
                            ? 'bg-tempest/10 text-tempest border border-tempest/30'
                            : 'bg-muted text-muted-foreground'
                        }`}
                      >
                        {item.badge}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</aside>

<!-- Mobile backdrop -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 hidden bg-black/50 backdrop-blur-xs md:hidden"
  aria-hidden="true"
></div>

<script>
  function setupMobileSidebar() {
    const toggle = document.getElementById('mobile-sidebar-toggle');
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');

    if (!toggle || !sidebar || !backdrop) return;

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', () => {
      const isOpen = !sidebar.classList.contains('-translate-x-full');
      if (isOpen) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    backdrop.addEventListener('click', closeSidebar);
  }

  setupMobileSidebar();
  document.addEventListener('astro:page-load', setupMobileSidebar);
</script>

---
import { getIcon } from './icons';

export interface NavItem {
  title: string;
  url: string;
  icon?: string;
  badge?: string;
}

export interface NavGroup {
  name: string;
  items: NavItem[];
}

interface Props {
  currentPath: string;
  groups: NavGroup[];
  class?: string;
}

const { currentPath, groups, class: className = '' } = Astro.props;

const cleanCurrent = currentPath.replace(/\/$/, '') || '/docs';
---

<aside
  id="sidebar"
  class={`fixed top-16 bottom-0 left-0 z-50 w-72 -translate-x-full border-r border-border/80 bg-background pt-6 transition-transform duration-200 md:sticky md:bottom-auto md:z-0 md:h-[calc(100vh-4rem)] md:w-60 md:shrink-0 md:translate-x-0 md:border-r-0 md:bg-transparent md:pt-8 ${className}`}
>
  <div class="scrollbar-subtle h-full overflow-y-auto px-4 pb-12 md:pl-0 md:pr-4">
    <nav class="space-y-7" aria-label="Documentation">
      {groups.map((group) => (
        <div>
          <h4 class="mb-2 px-3 text-xs font-semibold text-foreground">
            {group.name}
          </h4>
          <ul class="space-y-0.5">
            {group.items.map((item) => {
              const isActive = cleanCurrent === item.url.replace(/\/$/, '');
              const Icon = getIcon(item.icon);

              return (
                <li>
                  <a
                    href={item.url}
                    aria-current={isActive ? 'page' : undefined}
                    class={`group flex items-center gap-2.5 rounded-lg px-3 py-1.5 text-sm transition-colors ${
                      isActive
                        ? 'bg-tempest/[0.08] font-medium text-tempest dark:bg-tempest/[0.14]'
                        : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground'
                    }`}
                  >
                    <Icon
                      class={`h-4 w-4 shrink-0 ${isActive ? 'text-tempest' : 'text-muted-foreground/70 group-hover:text-foreground'}`}
                    />
                    <span class="min-w-0 flex-1">{item.title}</span>
                    {item.badge && (
                      <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                        {item.badge}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</aside>

<div
  id="sidebar-backdrop"
  class="fixed inset-x-0 top-16 bottom-0 z-40 hidden bg-black/40 md:hidden"
  aria-hidden="true"
></div>

<script>
  function setupMobileSidebar() {
    const toggle = document.getElementById('mobile-sidebar-toggle');
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');

    if (!toggle || !sidebar || !backdrop) return;
    if (toggle.dataset.bound) return;
    toggle.dataset.bound = 'true';

    function setOpen(open: boolean) {
      sidebar!.classList.toggle('-translate-x-full', !open);
      backdrop!.classList.toggle('hidden', !open);
      toggle!.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', () => {
      setOpen(sidebar.classList.contains('-translate-x-full'));
    });
    backdrop.addEventListener('click', () => setOpen(false));

    // Close mobile sidebar when navigating via any link in the sidebar
    sidebar.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }

  setupMobileSidebar();
  document.addEventListener('astro:page-load', setupMobileSidebar);
</script>

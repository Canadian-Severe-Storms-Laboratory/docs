---
import type { MarkdownHeading } from 'astro';
import { CircleHelp, SquarePen } from 'lucide-astro';

interface Props {
  headings: MarkdownHeading[];
  editUrl?: string;
}

const { headings, editUrl } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="scrollbar-subtle sticky top-16 hidden h-[calc(100vh-4rem)] w-56 shrink-0 overflow-y-auto pt-8 pb-8 xl:block">
  {tocHeadings.length > 0 && (
    <>
      <h4 class="mb-3 text-xs font-semibold text-foreground">On this page</h4>
      <ul class="space-y-2 border-l border-border/70 text-[13px]">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-slug={heading.slug}
              class={`toc-link -ml-px block border-l border-transparent leading-snug text-muted-foreground transition-colors hover:text-foreground ${
                heading.depth === 3 ? 'pl-6' : 'pl-3'
              }`}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="mt-8 space-y-2 border-t border-border/70 pt-5 text-[13px] text-muted-foreground">
    {editUrl && (
      <a href={editUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-foreground">
        <SquarePen class="h-3.5 w-3.5" />
        Edit this page
      </a>
    )}
    <a
      href="https://github.com/Canadian-Severe-Storms-Laboratory/docs/issues/new"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 hover:text-foreground"
    >
      <CircleHelp class="h-3.5 w-3.5" />
      Report an issue
    </a>
  </div>
</aside>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
  const targets = links
    .map((link) => document.getElementById(link.dataset.slug ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  function highlight() {
    let current: string | undefined = targets[0]?.id;
    for (const target of targets) {
      if (target.getBoundingClientRect().top > 120) break;
      current = target.id;
    }
    // At the bottom of the page the last sections can't scroll to the top.
    if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
      current = targets.at(-1)?.id;
    }
    for (const link of links) {
      const active = link.dataset.slug === current;
      link.classList.toggle('text-tempest', active);
      link.classList.toggle('border-tempest', active);
      link.classList.toggle('text-muted-foreground', !active);
      link.classList.toggle('border-transparent', !active);
    }
  }

  if (targets.length > 0) {
    window.addEventListener('scroll', highlight, { passive: true });
    highlight();
  }
</script>

---
import type { MarkdownHeading } from 'astro';
import { Edit3, HelpCircle } from 'lucide-astro';

interface Props {
  headings: MarkdownHeading[];
  class?: string;
}

const { headings, class: className = '' } = Astro.props;

// Only show H2 and H3
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <div class={`sticky top-20 hidden w-64 shrink-0 xl:block ${className}`}>
    <div class="h-[calc(100vh-6rem)] overflow-y-auto px-4 pb-8">
      <h4 class="mb-3 text-[11px] font-bold tracking-[0.14em] text-muted-foreground/80 uppercase">
        On this page
      </h4>
      <ul class="space-y-2 text-xs" id="toc-list">
        {filteredHeadings.map((heading) => (
          <li class={`${heading.depth === 3 ? 'ml-3' : ''}`}>
            <a
              href={`#${heading.slug}`}
              class="toc-link block py-0.5 text-muted-foreground transition-colors hover:text-foreground line-clamp-1"
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>

      <hr class="my-6 border-border/70" />

      <!-- Quick action links -->
      <div class="space-y-2 text-xs text-muted-foreground">
        <a
          href="https://github.com/Canadian-Severe-Storms-Laboratory/docs"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-foreground transition-colors"
        >
          <Edit3 class="h-3.5 w-3.5 text-muted-foreground/70" />
          <span>Edit this page on GitHub</span>
        </a>
        <a
          href="https://github.com/Canadian-Severe-Storms-Laboratory/mesonet/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-foreground transition-colors"
        >
          <HelpCircle class="h-3.5 w-3.5 text-muted-foreground/70" />
          <span>Report an issue</span>
        </a>
      </div>
    </div>
  </div>
)}

<script>
  function setupTocScrollspy() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (links.length === 0) return;

    const headingElements: HTMLElement[] = [];
    links.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    if (headingElements.length === 0) return;

    function onScroll() {
      const scrollY = window.scrollY;
      let currentId = '';

      for (const heading of headingElements) {
        const top = heading.getBoundingClientRect().top + window.scrollY - 100;
        if (scrollY >= top) {
          currentId = heading.id;
        } else {
          break;
        }
      }

      if (!currentId && headingElements[0]) {
        currentId = headingElements[0].id;
      }

      links.forEach((link) => {
        if (link.getAttribute('data-slug') === currentId) {
          link.classList.add('text-tempest', 'font-medium');
          link.classList.remove('text-muted-foreground');
        } else {
          link.classList.remove('text-tempest', 'font-medium');
          link.classList.add('text-muted-foreground');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  setupTocScrollspy();
  document.addEventListener('astro:page-load', setupTocScrollspy);
</script>

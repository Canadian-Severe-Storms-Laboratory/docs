---
import { Search } from 'lucide-astro';
---

<div
  id="search-dialog"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 p-4 pt-16 backdrop-blur-sm sm:pt-24"
  role="dialog"
  aria-modal="true"
  aria-label="Search documentation"
>
  <div class="w-full max-w-xl overflow-hidden rounded-2xl border border-border bg-popover shadow-2xl">
    <div class="flex items-center gap-3 border-b border-border/80 px-4">
      <Search class="h-4 w-4 shrink-0 text-muted-foreground" />
      <input
        type="search"
        id="search-input"
        placeholder="Search docs"
        autocomplete="off"
        spellcheck="false"
        aria-controls="search-list"
        class="h-12 w-full bg-transparent text-sm text-foreground placeholder:text-muted-foreground focus:outline-none [&::-webkit-search-cancel-button]:hidden"
      />
      <kbd class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">Esc</kbd>
    </div>

    <div class="max-h-[min(24rem,60vh)] overflow-y-auto p-2">
      <p id="search-empty" class="hidden px-3 py-8 text-center text-sm text-muted-foreground">No results.</p>
      <ul id="search-list" role="listbox" class="space-y-0.5"></ul>
    </div>
  </div>
</div>

<script>
  interface SearchEntry {
    title: string;
    description: string;
    group: string;
    url: string;
    headings: { text: string; slug: string }[];
  }

  interface Result {
    title: string;
    context: string;
    url: string;
  }

  const dialog = document.getElementById('search-dialog')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-list')!;
  const empty = document.getElementById('search-empty')!;

  let entries: SearchEntry[] | null = null;
  let results: Result[] = [];
  let active = 0;

  async function loadIndex() {
    if (entries) return;
    try {
      const res = await fetch('/api/search.json');
      entries = res.ok ? await res.json() : [];
    } catch {
      entries = [];
    }
  }

  function search(query: string): Result[] {
    const q = query.trim().toLowerCase();
    if (!entries) return [];
    if (!q) {
      return entries.map((e) => ({ title: e.title, context: e.group, url: e.url }));
    }

    const pages: Result[] = [];
    const sections: Result[] = [];
    for (const e of entries) {
      if (`${e.title} ${e.description} ${e.group}`.toLowerCase().includes(q)) {
        pages.push({ title: e.title, context: e.group, url: e.url });
      }
      for (const h of e.headings) {
        if (h.text.toLowerCase().includes(q)) {
          sections.push({ title: h.text, context: e.title, url: `${e.url}#${h.slug}` });
        }
      }
    }
    return [...pages, ...sections].slice(0, 30);
  }

  function render() {
    results = search(input.value);
    active = 0;
    list.replaceChildren(
      ...results.map((r, i) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = r.url;
        a.setAttribute('role', 'option');
        a.dataset.index = String(i);
        a.className = 'search-result flex flex-col rounded-lg px-3 py-2 text-sm';

        const title = document.createElement('span');
        title.className = 'font-medium text-foreground';
        title.textContent = r.title;
        const context = document.createElement('span');
        context.className = 'text-xs text-muted-foreground';
        context.textContent = r.context;

        a.append(title, context);
        a.addEventListener('mousemove', () => select(i));
        a.addEventListener('click', close);
        li.appendChild(a);
        return li;
      }),
    );
    empty.classList.toggle('hidden', results.length > 0);
    select(0);
  }

  function select(i: number) {
    active = i;
    list.querySelectorAll<HTMLElement>('.search-result').forEach((el, idx) => {
      const selected = idx === i;
      el.classList.toggle('bg-muted', selected);
      el.setAttribute('aria-selected', String(selected));
      if (selected) el.scrollIntoView({ block: 'nearest' });
    });
  }

  async function open() {
    dialog.classList.remove('hidden');
    dialog.classList.add('flex');
    document.body.style.overflow = 'hidden';
    input.focus();
    await loadIndex();
    render();
  }

  function close() {
    dialog.classList.add('hidden');
    dialog.classList.remove('flex');
    document.body.style.overflow = '';
    input.value = '';
  }

  const isOpen = () => !dialog.classList.contains('hidden');

  document.querySelectorAll('[data-search-trigger]').forEach((el) => el.addEventListener('click', open));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  input.addEventListener('input', render);

  window.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const typing = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable;

    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      isOpen() ? close() : open();
    } else if (e.key === '/' && !typing && !isOpen()) {
      e.preventDefault();
      open();
    } else if (isOpen()) {
      if (e.key === 'Escape') {
        close();
      } else if (e.key === 'ArrowDown' && results.length) {
        e.preventDefault();
        select((active + 1) % results.length);
      } else if (e.key === 'ArrowUp' && results.length) {
        e.preventDefault();
        select((active - 1 + results.length) % results.length);
      } else if (e.key === 'Enter' && results[active]) {
        e.preventDefault();
        window.location.href = results[active].url;
        close();
      }
    }
  });
</script>
